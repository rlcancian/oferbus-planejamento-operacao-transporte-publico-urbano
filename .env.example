# OferBus 2026 — local-development example only.
# Copy to .env and replace placeholders as appropriate. Never commit real credentials.

WEB_PORT=3010
API_PORT=8010
OFERBUS_ENV=development
OFERBUS_API_URL=http://127.0.0.1:8010

POSTGRES_DB=oferbus
POSTGRES_USER=oferbus
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://oferbus:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/oferbus

# Phase A.3 identity adapter. development-header is forbidden in production.
OFERBUS_IDENTITY_MODE=development-header

# Phase A.4 PostgreSQL-backed worker.
OFERBUS_WORKER_POLL_SECONDS=1.0
OFERBUS_WORKER_LEASE_SECONDS=60
OFERBUS_WORKER_ID=

# Future Phase A.5 AI integration; leave unset until provider selection.
OFERBUS_AI_PROVIDER=
OFERBUS_AI_MODEL=
